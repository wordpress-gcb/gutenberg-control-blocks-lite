{
	"controls": [
		{ "id": "panel", "type": "group", "label": "Map" },

		{ "id": "ctrl_location",
		  "type": "google-map",
		  "label": "Location",
		  "attributeKey": "location",
		  "default": { "address": "", "lat": null, "lng": null, "zoom": 12 },
		  "parentPanelId": "panel" },

		{ "id": "ctrl_map_id",
		  "type": "text",
		  "label": "Map ID (style)",
		  "attributeKey": "mapId",
		  "default": "",
		  "placeholder": "e.g. 8e0a97af9386fef",
		  "helpText": "Style the map in Google Cloud (Maps Studio) and paste its Map ID here. Cloud styling replaces the deprecated JSON styles.",
		  "parentPanelId": "panel" }
	]
}
